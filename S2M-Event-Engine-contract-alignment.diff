+def quaternion_to_yaw(q):
+    """Yaw only; the chassis is planar so roll and pitch are discarded."""
+    siny = 2.0 * (q.w * q.z + q.x * q.y)
+    cosy = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
+    return math.atan2(siny, cosy)
 
 
