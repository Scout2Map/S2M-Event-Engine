+
+    # Set per mapping run so events from different maps are not mixed on one
+    # coordinate plane. Empty means unidentified.
+    map_id: ""
+
+    # Emit a 'cleared' event when a hazard returns to normal, so the dashboard
+    # can retire the marker and the drive policy can lift its speed limit
+    publish_clear_events: true
+
+    # Empty means ~/.scout2map/threshold.db
+    threshold_db_path: ""
+
+    # --- rough terrain ---
+    rough_window_s: 1.0
+    rough_min_samples: 10
+
+    # --- rotation difficulty ---
